# ---- LLM providers (v0.6a — multi-provider) -----------------------------------
# Global default provider. Each agent role can override below.
LLM_PROVIDER=anthropic
DEFAULT_MODEL=claude-opus-4-7

# Anthropic (native)
ANTHROPIC_API_KEY=sk-ant-replace-me

# DeepSeek — uses anthropic SDK against api.deepseek.com/anthropic.
# Leave key blank if you don't plan to route any role to deepseek.
DEEPSEEK_API_KEY=

# Per-role overrides — uncomment to mix providers across the pipeline.
# Cheap/high-volume work → DeepSeek; critical decisions → Claude.
# BABEL_PROVIDER=deepseek
# BABEL_MODEL=deepseek-chat
# ANALYST_PROVIDER=deepseek
# ANALYST_MODEL=deepseek-chat
# ARCHITECT_PROVIDER=anthropic
# ARCHITECT_MODEL=claude-opus-4-7
# ORCHESTRATOR_PROVIDER=anthropic
# WORKER_PROVIDER=anthropic
# REVIEWER_PROVIDER=anthropic
# SECURITY_REVIEWER_PROVIDER=anthropic    # (faz 6b)
# TEST_REVIEWER_PROVIDER=deepseek         # (faz 6b)
# PERF_REVIEWER_PROVIDER=deepseek         # (faz 6b)

# Token budgets
TOKEN_BUDGET_PER_TASK=50000
TOKEN_BUDGET_PER_PROJECT=2000000

# Determinism (set per agent role)
TEMPERATURE_CODE=0.0
TEMPERATURE_DESIGN=0.3
TEMPERATURE_BRAINSTORM=0.7

# Audit
AUDIT_LOG_PATH=./ortim/audit/decisions.jsonl

# Workspaces
WORKSPACE_ROOT=./workspaces

# ---- Ortim runtime knobs ------------------------------------------------------
# Legacy AI_FACTORY_* names are still read with a deprecation warning;
# they will be removed after one more minor release.

# Executor — git branch isolation per task. auto = on if `git` is on PATH.
ORTIM_GIT_ENABLED=auto

# Test runner — opt-in. If set, runner executes this command in the workspace
# before review. Failed tests force the Reviewer to reject.
# ORTIM_TEST_CMD=pytest -q
# ORTIM_TEST_CMD=npm test --silent
# ORTIM_TEST_CMD=go test ./...
ORTIM_TESTS_ENABLED=true

# ---- Multi-reviewer (v0.6b — Security/Test/Perf hard veto) --------------------
# `on` enables Security + Test (hard veto) + Perf (soft veto, informational).
# Hard veto bypasses the retry budget and sends the task straight to AWAITING_HITL.
# Default `off` preserves pre-6b CodeReviewer-only behavior.
ORTIM_HARD_REVIEWERS=off

# ---- Hooks (v0.6c — pre-commit / pre-deploy) ----------------------------------
# Hooks run as shell commands inside the task workspace. Exit 0 → pass; non-zero
# blocks the corresponding action. Leave unset to skip.
ORTIM_HOOKS_ENABLED=true
# Run after Reviewer chain approves but before `git commit`. A fail sends the
# task back to PENDING (retry budget consumed).
# ORTIM_LINT_CMD=ruff check .
# ORTIM_FORMAT_CHECK_CMD=ruff format --check .
# Run on G6 (DEPLOY_AWAITING_APPROVAL → DONE) — wired in iter 6c+.
# ORTIM_DEPLOY_CMD=./scripts/deploy.sh

# ---- Budget cap (v0.6c — G7) --------------------------------------------------
# When set, project spend ≥ cap routes the project to BUDGET_AWAITING_APPROVAL.
# Leave unset for no cap.
# ORTIM_BUDGET_CAP_USD=50.00
