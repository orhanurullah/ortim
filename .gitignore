# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts (regenerable via `python -m build`)
dist/
build/

# Stray sdist extracts (accidental tar -xf in repo root)
ortim-[0-9]*/

# Environment
.env
.env.local
*.key
*.pem

# Workspaces (per-project runtime data)
workspaces/*/
!workspaces/.gitkeep

# Audit logs
ortim/audit/*.log
ortim/audit/*.jsonl
# Legacy path (kept until R7 — operators with old AUDIT_LOG_PATH in .env)
runtime/audit/*.log
runtime/audit/*.jsonl

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini
